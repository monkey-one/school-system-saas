APP_NAME=EduSaaS
# Use APP_ENV=production and APP_DEBUG=false on a live server.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Main domain(s) of the SaaS; schools get <slug>.<domain> subdomains.
APP_BASE_DOMAINS=localhost
# School shown when no subdomain/?tenant= is given (single-school installs).
APP_DEFAULT_TENANT=demo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use LOG_LEVEL=error in production.
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edusaas
DB_USERNAME=edusaas
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set SESSION_ENCRYPT=true and SESSION_SECURE_COOKIE=true when served over HTTPS.
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Private uploads (PPDB documents, leave letters, e-learning files) always use
# the "local" disk; public images (logos, website photos) use "public".
FILESYSTEM_DISK=local
FILAMENT_FILESYSTEM_DISK=public

# "database" works everywhere; switch to "redis" for high traffic.
# A queue worker must run: php artisan queue:work (see docs/DEVELOPER_GUIDE.md).
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp (Fonnte API)
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_API_TOKEN=

# Payment Gateway - Midtrans (leave empty to disable online payment)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Payment Gateway - Xendit (leave empty to disable)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Super Admin account created by the seeder. CHANGE THE PASSWORD after the
# first login on a live server.
SUPER_ADMIN_EMAIL=superadmin@edusaas.id
SUPER_ADMIN_PASSWORD=password

# Public demo mode: NEVER enable on a real school's installation.
DEMO_MODE=false
DEMO_RESET_CRON="0 */6 * * *"

# Developer credit on public pages (leave APP_AUTHOR_NAME empty to hide).
APP_AUTHOR_NAME="PT Danum Inovasi Teknologi"
APP_AUTHOR_BRAND=numintek
APP_AUTHOR_URL=https://numintek.com
APP_AUTHOR_WHATSAPP=6285220091770
